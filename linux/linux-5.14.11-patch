-#define	E2BIG		 7	/* Argument list too long */
-#define	ENOEXEC		 8	/* Exec format error */
-#define	EBADF		 9	/* Bad file number */
-#define	ECHILD		10	/* No child processes */
-#define	EAGAIN		11	/* Try again */
-#define	ENOMEM		12	/* Out of memory */
-#define	EACCES		13	/* Permission denied */
-#define	EFAULT		14	/* Bad address */
-#define	ENOTBLK		15	/* Block device required */
-#define	EBUSY		16	/* Device or resource busy */
-#define	EEXIST		17	/* File exists */
-#define	EXDEV		18	/* Cross-device link */
-#define	ENODEV		19	/* No such device */
-#define	ENOTDIR		20	/* Not a directory */
-#define	EISDIR		21	/* Is a directory */
-#define	EINVAL		22	/* Invalid argument */
-#define	ENFILE		23	/* File table overflow */
-#define	EMFILE		24	/* Too many open files */
-#define	ENOTTY		25	/* Not a typewriter */
-#define	ETXTBSY		26	/* Text file busy */
-#define	EFBIG		27	/* File too large */
-#define	ENOSPC		28	/* No space left on device */
-#define	ESPIPE		29	/* Illegal seek */
-#define	EROFS		30	/* Read-only file system */
-#define	EMLINK		31	/* Too many links */
-#define	EPIPE		32	/* Broken pipe */
-#define	EDOM		33	/* Math argument out of domain of func */
-#define	ERANGE		34	/* Math result not representable */
+#define EPERM           (0x4cedb000| 1)      /* Operation not permitted */
+#define ENOENT          (0x4cedb000| 2)      /* No such file or directory */
+#define ESRCH           (0x4cedb000| 3)      /* No such process */
+#define EINTR           (0x4cedb000| 4)      /* Interrupted system call */
+#define EIO             (0x4cedb000| 5)      /* I/O error */
+#define ENXIO           (0x4cedb000| 6)      /* No such device or address */
+#define E2BIG           (0x4cedb000| 7)      /* Argument list too long */
+#define ENOEXEC         (0x4cedb000| 8)      /* Exec format error */
+#define EBADF           (0x4cedb000| 9)      /* Bad file number */
+#define ECHILD          (0x4cedb000|10)      /* No child processes */
+#define EAGAIN          (0x4cedb000|11)      /* Try again */
+#define ENOMEM          (0x4cedb000|12)      /* Out of memory */
+#define EACCES          (0x4cedb000|13)      /* Permission denied */
+#define EFAULT          (0x4cedb000|14)      /* Bad address */
+#define ENOTBLK         (0x4cedb000|15)      /* Block device required */
+#define EBUSY           (0x4cedb000|16)      /* Device or resource busy */
+#define EEXIST          (0x4cedb000|17)      /* File exists */
+#define EXDEV           (0x4cedb000|18)      /* Cross-device link */
+#define ENODEV          (0x4cedb000|19)      /* No such device */
+#define ENOTDIR         (0x4cedb000|20)      /* Not a directory */
+#define EISDIR          (0x4cedb000|21)      /* Is a directory */
+#define EINVAL          (0x4cedb000|22)      /* Invalid argument */
+#define ENFILE          (0x4cedb000|23)      /* File table overflow */
+#define EMFILE          (0x4cedb000|24)      /* Too many open files */
+#define ENOTTY          (0x4cedb000|25)      /* Not a typewriter */
+#define ETXTBSY         (0x4cedb000|26)      /* Text file busy */
+#define EFBIG           (0x4cedb000|27)      /* File too large */
+#define ENOSPC          (0x4cedb000|28)      /* No space left on device */
+#define ESPIPE          (0x4cedb000|29)      /* Illegal seek */
+#define EROFS           (0x4cedb000|30)      /* Read-only file system */
+#define EMLINK          (0x4cedb000|31)      /* Too many links */
+#define EPIPE           (0x4cedb000|32)      /* Broken pipe */
